{
    "info": {
        "_postman_id": "clinic-appointment-collection",
        "name": "Klinik Admin - Janji Temu (Appointments)",
        "description": "Postman collection for managing Clinic Appointment data in the Klinik Admin system.\n\n## Setup Instructions:\n\n1. **Start Frappe Server**:\n   ```\n   cd api-clinic\n   bench start\n   ```\n\n2. **Get API Keys** (in Frappe):\n   - Go to User Settings → API Access\n   - Generate API Key and API Secret\n\n3. **Set Variables**:\n   - `base_url`: Your Frappe URL (e.g., `http://localhost:8000`)\n   - `api_key`: Your Frappe API Key\n   - `api_secret`: Your Frappe API Secret\n\n## DocType: Clinic Appointment\nFormat: APP-.YYYY.-.#####",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "api_key",
            "value": "YOUR_API_KEY",
            "type": "string"
        },
        {
            "key": "api_secret",
            "value": "YOUR_API_SECRET",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Custom API (App Flow)",
            "item": [
                {
                    "name": "1. Create Appointment (App Logic)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"serviceId\": 1,\n    \"serviceName\": \"General Checkup\",\n    \"doctorId\": 0,\n    \"doctorName\": \"Dr. Siti Aminah\",\n    \"date\": \"2026-03-10T09:00:00.000Z\",\n    \"finalPrice\": 150000,\n    \"patientDetail\": {\n        \"name\": \"Budi Santoso\",\n        \"nik\": \"3171234567890001\",\n        \"phone\": \"08123456789\",\n        \"address\": \"Jl. Sudirman No. 1\"\n    },\n    \"notes\": \"Keluhan pusing\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/api_clinic.clinicfrontdesk.appointment_api.create_appointment",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "api_clinic.clinicfrontdesk.appointment_api.create_appointment"
                            ]
                        },
                        "description": "Creates an appointment using logic matches the Flutter App (resolves Patient/Doctor logic)."
                    }
                },
                {
                    "name": "2. Get Appointments (App Logic)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"filters\": {\n        \"status\": [\"!=\", \"Cancelled\"]\n    }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/api_clinic.clinicfrontdesk.appointment_api.get_appointments",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "api_clinic.clinicfrontdesk.appointment_api.get_appointments"
                            ]
                        },
                        "description": "Get appointments with custom response fields used by App."
                    }
                },
                {
                    "name": "3. Create Invoice",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"appointment_id\": \"APP-2026-00001\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/api_clinic.clinicfrontdesk.appointment_api.create_invoice",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "api_clinic.clinicfrontdesk.appointment_api.create_invoice"
                            ]
                        },
                        "description": "Generate invoice for appointment."
                    }
                },
                {
                    "name": "4. Simulate Payment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"appointment_id\": \"APP-2026-00001\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/api_clinic.clinicfrontdesk.appointment_api.simulate_payment",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "api_clinic.clinicfrontdesk.appointment_api.simulate_payment"
                            ]
                        },
                        "description": "Mark appointment as Paid/Attended."
                    }
                }
            ]
        },
        {
            "name": "Standard CRUD (Admin)",
            "item": [
                {
                    "name": "1. Get All Appointments",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/resource/Clinic%20Appointment?fields=[\"name\",\"patient\",\"practitioner\",\"appointment_date\",\"appointment_time\",\"status\"]&limit_page_length=50",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "resource",
                                "Clinic%20Appointment"
                            ],
                            "query": [
                                {
                                    "key": "fields",
                                    "value": "[\"name\",\"patient\",\"practitioner\",\"appointment_date\",\"appointment_time\",\"status\"]"
                                },
                                {
                                    "key": "limit_page_length",
                                    "value": "50"
                                }
                            ]
                        },
                        "description": "Get list of all appointments."
                    }
                },
                {
                    "name": "2. Get Single Appointment",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/resource/Clinic%20Appointment/APP-2026-00001",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "resource",
                                "Clinic%20Appointment",
                                "APP-2026-00001"
                            ]
                        },
                        "description": "Get a single appointment by ID. Replace APP-2026-00001 with actual ID."
                    }
                },
                {
                    "name": "3. Delete Appointment",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/resource/Clinic%20Appointment/APP-2026-00001",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "resource",
                                "Clinic%20Appointment",
                                "APP-2026-00001"
                            ]
                        },
                        "description": "Delete an appointment."
                    }
                }
            ]
        },
        {
            "name": "Utilities",
            "item": [
                {
                    "name": "Test Server Connection",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/method/frappe.ping",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "frappe.ping"
                            ]
                        },
                        "description": "Test if Frappe server is running. Should return {\"message\": \"pong\"}"
                    }
                },
                {
                    "name": "Sample Data Inject (10 Appointments)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "token {{api_key}}:{{api_secret}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"docs\": [\n        {\n            \"doctype\": \"Clinic Appointment\",\n            \"patient\": \"PAT-0001\",\n            \"practitioner\": \"PRAC-0001\",\n            \"polyclinic\": \"POLY-0001\",\n            \"appointment_date\": \"2026-02-03\",\n            \"appointment_time\": \"08:00:00\",\n            \"service_type\": \"On-site (DO)\",\n            \"status\": \"Confirmed\",\n            \"facility\": \"FACI-0001\",\n            \"company\": \"COMP-0001\",\n            \"notes\": \"Pemeriksaan rutin - Siti Aminah\"\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/method/frappe.client.bulk_insert",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "method",
                                "frappe.client.bulk_insert"
                            ]
                        },
                        "description": "Inject sample structure directly."
                    }
                }
            ]
        }
    ]
}