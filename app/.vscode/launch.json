            "args": [
                "-d",
                "chrome",
                "--web-renderer",
                "html",
                "--no-web-resources-cdn"
            ]
        },
        {
            "name": "Flutter Web (CanvasKit - High Quality)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "-d",
                "edge",
                "--web-renderer",
